---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('ideas');
const articles = allArticles.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const featured = articles.find((a) => a.data.featured);
const rest = articles.filter((a) => !a.data.featured);
---

<BaseLayout
  title="Ideas — Facética"
  description="Reflexiones, análisis y perspectivas sobre comunicación estratégica, manejo de crisis, reputación y narrativa institucional."
>
  <!-- Header -->
  <section class="ideas-header">
    <div class="container">
      <span class="eyebrow">Publicaciones</span>
      <h1 class="ideas-title">Ideas</h1>
      <p class="ideas-sub lead">
        Reflexiones sobre comunicación estratégica, reputación y narrativa
        institucional.
      </p>
    </div>
  </section>

  <!-- Content -->
  <section class="ideas-content section">
    <div class="container">
      <!-- Featured -->
      {featured && (
        <a href={`/ideas/${featured.slug}`} class="ideas-featured reveal">
          <div class="ideas-featured-meta">
            <span class="text-label">{featured.data.category}</span>
            <time class="text-number ideas-date" datetime={featured.data.date}>
              {new Date(featured.data.date).toLocaleDateString('es-CL', { year: 'numeric', month: 'long' })}
            </time>
          </div>
          <h2 class="ideas-featured-title">{featured.data.title}</h2>
          <p class="ideas-featured-desc">{featured.data.description}</p>
          <span class="ideas-featured-cta">Leer →</span>
        </a>
      )}

      <!-- Articles grid -->
      <div class="ideas-grid">
        {rest.map((article, i) => (
          <a href={`/ideas/${article.slug}`} class={`idea-card reveal stagger-${Math.min(i + 1, 6)}`}>
            <div class="idea-card-meta">
              <span class="text-label">{article.data.category}</span>
              <time class="text-number idea-date" datetime={article.data.date}>
                {new Date(article.data.date).toLocaleDateString('es-CL', { year: 'numeric', month: 'long' })}
              </time>
            </div>
            <h2 class="idea-title">{article.data.title}</h2>
            <p class="idea-desc">{article.data.description}</p>
            <span class="idea-link">Leer →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ideas-header {
    background-color: var(--color-bg-secondary);
    padding-top: calc(var(--nav-height) + var(--space-80));
    padding-bottom: var(--space-80);
    border-bottom: 1px solid var(--color-border);
  }

  .ideas-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(3rem, 7vw, 5rem);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--color-text-primary);
    margin-top: var(--space-16);
    margin-bottom: var(--space-24);
  }

  .ideas-sub {
    max-width: 480px;
  }

  .ideas-content {
    background-color: var(--color-bg-primary);
  }

  /* ── Featured ── */
  .ideas-featured {
    display: block;
    padding: var(--space-48);
    background-color: var(--color-bg-dark);
    margin-bottom: var(--space-4);
    border-radius: 2px;
    transition: opacity var(--duration-base);
  }

  .ideas-featured:hover {
    opacity: 0.9;
  }

  .ideas-featured-meta {
    display: flex;
    align-items: center;
    gap: var(--space-24);
    margin-bottom: var(--space-24);
  }

  .ideas-date,
  .idea-date {
    color: rgba(240, 236, 228, 0.4);
  }

  .ideas-featured-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text-inverse);
    max-width: 680px;
    margin-bottom: var(--space-20);
  }

  .ideas-featured-desc {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: rgba(240, 236, 228, 0.6);
    max-width: 560px;
    margin-bottom: var(--space-32);
  }

  .ideas-featured-cta {
    font-size: 0.875rem;
    color: var(--color-accent-champagne);
    display: inline-block;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .ideas-featured:hover .ideas-featured-cta {
    transform: translateX(4px);
  }

  /* ── Grid ── */
  .ideas-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .idea-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    padding: var(--space-32);
    background-color: var(--color-bg-secondary);
    border-radius: 2px;
    transition: background-color var(--duration-base);
  }

  .idea-card:hover {
    background-color: #ebe7e0;
  }

  .idea-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
  }

  .idea-date {
    color: var(--color-text-muted);
  }

  .idea-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    flex: 1;
  }

  .idea-desc {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    flex: 1;
  }

  .idea-link {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-top: auto;
    display: inline-block;
    transition: color var(--duration-fast), transform var(--duration-base) var(--ease-out);
  }

  .idea-card:hover .idea-link {
    color: var(--color-accent);
    transform: translateX(3px);
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .ideas-featured {
      padding: var(--space-32);
    }

    .ideas-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
