---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contacto — Facética"
  description="Conversemos sobre cómo podemos aportar a la comunicación estratégica de su organización."
>
  <section class="contact-page">
    <div class="container">
      <div class="contact-grid">
        <!-- Left: Text -->
        <div class="contact-left reveal-left">
          <span class="eyebrow">Contacto</span>
          <h1 class="contact-title">
            Hay conversaciones que vale la pena tener.
          </h1>
          <p class="contact-sub">
            Si está evaluando cómo su organización comunica —o debería
            comunicar— podemos ser un buen punto de partida.
          </p>

          <div class="contact-info">
            <div class="contact-info-item">
              <span class="contact-info-label">Email</span>
              <a href="mailto:hola@facetica.com" class="contact-info-value">
                hola@facetica.com
              </a>
            </div>
            <div class="contact-info-item">
              <span class="contact-info-label">LinkedIn</span>
              <a
                href="https://www.linkedin.com/company/facetica"
                target="_blank"
                rel="noopener noreferrer"
                class="contact-info-value"
              >
                Facética en LinkedIn
              </a>
            </div>
            <div class="contact-info-item">
              <span class="contact-info-label">Ubicación</span>
              <span class="contact-info-value">Santiago, Chile</span>
            </div>
          </div>
        </div>

        <!-- Right: Form -->
        <div class="contact-right reveal-right">
          <form class="contact-form" name="contacto" method="POST" action="/gracias">
            <p class="form-note">Todos los campos son obligatorios.</p>

            <div class="form-group">
              <label class="form-label" for="nombre">Nombre</label>
              <input
                class="form-input"
                type="text"
                id="nombre"
                name="nombre"
                autocomplete="name"
                required
              />
            </div>

            <div class="form-group">
              <label class="form-label" for="organizacion">Organización</label>
              <input
                class="form-input"
                type="text"
                id="organizacion"
                name="organizacion"
                required
              />
            </div>

            <div class="form-group">
              <label class="form-label" for="email">Correo electrónico</label>
              <input
                class="form-input"
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                required
              />
            </div>

            <div class="form-group">
              <label class="form-label" for="mensaje">¿De qué trata la conversación?</label>
              <textarea
                class="form-input form-textarea"
                id="mensaje"
                name="mensaje"
                rows="5"
                required
              ></textarea>
            </div>

            <button type="submit" class="btn btn-primary form-submit">
              Enviar mensaje
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    padding-top: calc(var(--nav-height) + var(--space-80));
    padding-bottom: var(--space-120);
    min-height: 100svh;
    background-color: var(--color-bg-primary);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-80);
    align-items: start;
  }

  /* ── Left ── */
  .contact-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-top: var(--space-16);
    margin-bottom: var(--space-24);
  }

  .contact-sub {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 400px;
    margin-bottom: var(--space-48);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .contact-info-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact-info-label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .contact-info-value {
    font-size: 0.9375rem;
    color: var(--color-text-primary);
    transition: color var(--duration-fast);
  }

  a.contact-info-value:hover {
    color: var(--color-accent);
  }

  /* ── Form ── */
  .contact-right {
    background-color: var(--color-bg-secondary);
    padding: var(--space-48);
    border-radius: 2px;
  }

  .form-note {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-32);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .form-label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
  }

  .form-input {
    width: 100%;
    padding: 0.75rem 0;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-border);
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    color: var(--color-text-primary);
    transition: border-color var(--duration-base);
    outline: none;
    resize: none;
  }

  .form-input::placeholder {
    color: var(--color-text-muted);
  }

  .form-input:focus {
    border-bottom-color: var(--color-accent);
  }

  .form-textarea {
    min-height: 120px;
    line-height: 1.6;
  }

  .form-submit {
    align-self: flex-start;
    margin-top: var(--space-8);
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-right {
      padding: var(--space-32);
    }

    .form-submit {
      width: 100%;
    }
  }
</style>
