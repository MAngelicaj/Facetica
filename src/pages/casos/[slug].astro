---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTAStrip from '../../components/home/ContactCTAStrip.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const casos = await getCollection('casos');
  return casos.map((caso) => ({
    params: { slug: caso.slug },
    props: { caso },
  }));
}

const { caso } = Astro.props;
const { Content } = await caso.render();
---

<BaseLayout
  title={`${caso.data.title} — Casos — Facética`}
  description={caso.data.description}
>
  <article class="caso-page">
    <!-- Header -->
    <header class="caso-header">
      <div class="container">
        <div class="caso-nav">
          <a href="/casos" class="back-link">← Todos los casos</a>
        </div>
        <div class="caso-meta">
          <span class="eyebrow">{caso.data.sector}</span>
          <span class="caso-challenge text-number">{caso.data.challenge}</span>
        </div>
        <h1 class="caso-headline">{caso.data.title}</h1>
        <p class="caso-lead">{caso.data.description}</p>
      </div>
    </header>

    <!-- Body -->
    <div class="caso-body section">
      <div class="container">
        <div class="caso-grid">
          <div class="prose">
            <Content />
          </div>
          <aside class="caso-sidebar">
            <div class="sidebar-block">
              <span class="sidebar-label">Sector</span>
              <p class="sidebar-value">{caso.data.sector}</p>
            </div>
            <hr class="rule" />
            <div class="sidebar-block">
              <span class="sidebar-label">Desafío</span>
              <p class="sidebar-value">{caso.data.challenge}</p>
            </div>
            <hr class="rule" />
            <div class="sidebar-block">
              <a href="/contacto" class="btn btn-primary sidebar-cta">
                Conversemos
              </a>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </article>

  <ContactCTAStrip />
</BaseLayout>

<style>
  .caso-header {
    background-color: var(--color-bg-secondary);
    padding-top: calc(var(--nav-height) + var(--space-48));
    padding-bottom: var(--space-80);
    border-bottom: 1px solid var(--color-border);
  }

  .caso-nav {
    margin-bottom: var(--space-48);
  }

  .back-link {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    transition: color var(--duration-fast);
  }

  .back-link:hover {
    color: var(--color-text-primary);
  }

  .caso-meta {
    display: flex;
    align-items: center;
    gap: var(--space-24);
    margin-bottom: var(--space-24);
  }

  .caso-challenge {
    color: var(--color-text-muted);
  }

  .caso-headline {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--color-text-primary);
    max-width: 760px;
    margin-bottom: var(--space-24);
  }

  .caso-lead {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 600px;
  }

  .caso-body {
    background-color: var(--color-bg-primary);
  }

  .caso-grid {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--space-80);
    align-items: start;
  }

  .caso-sidebar {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-32));
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    background-color: var(--color-bg-secondary);
    padding: var(--space-32);
    border-radius: 2px;
  }

  .sidebar-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .sidebar-label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .sidebar-value {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .sidebar-cta {
    width: 100%;
    text-align: center;
  }

  .prose h2 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    margin-top: var(--space-64);
    margin-bottom: var(--space-24);
    color: var(--color-text-primary);
  }

  .prose p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
    max-width: 65ch;
  }

  .prose p + p {
    margin-top: var(--space-20);
  }

  @media (max-width: 900px) {
    .caso-grid {
      grid-template-columns: 1fr;
    }

    .caso-sidebar {
      position: static;
    }
  }
</style>
