---
const services = [
  { href: '/servicios/comunicacion-corporativa', label: 'Comunicación Corporativa' },
  { href: '/servicios/manejo-de-crisis', label: 'Manejo de Crisis' },
  { href: '/servicios/entrenamiento-de-portavoces', label: 'Vocería Estratégica' },
  { href: '/servicios/presencia-digital', label: 'Presencia Digital' },
  { href: '/servicios/comunicacion-interna', label: 'Comunicación Interna' },
  { href: '/servicios/contenido-editorial', label: 'Contenido Editorial' },
  { href: '/servicios/comunicacion-de-sustentabilidad', label: 'Sustentabilidad & Cultura' },
];

const navLinks = [
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/casos', label: 'Casos' },
  { href: '/ideas', label: 'Ideas' },
  { href: '/contacto', label: 'Contacto' },
];

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <!-- Top: Wordmark + tagline -->
    <div class="footer-top">
      <a href="/" class="footer-logo">
        <img src="/logo.png" alt="Facética" class="footer-logo-img" />
      </a>
      <p class="footer-tagline">Consultoría de Comunicación Estratégica · Santiago, Chile</p>
    </div>

    <hr class="rule" />

    <!-- Middle: Columns -->
    <div class="footer-grid">
      <!-- Nav Column -->
      <div class="footer-col">
        <span class="footer-col-label">Navegación</span>
        <ul class="footer-links">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services Column -->
      <div class="footer-col">
        <span class="footer-col-label">Servicios</span>
        <ul class="footer-links">
          {services.map((s) => (
            <li>
              <a href={s.href} class="footer-link">{s.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Column -->
      <div class="footer-col">
        <span class="footer-col-label">Contacto</span>
        <ul class="footer-links">
          <li>
            <a href="mailto:hola@facetica.com" class="footer-link">hola@facetica.com</a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/company/facetica"
              class="footer-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>

    <hr class="rule" />

    <!-- Bottom: Copyright -->
    <div class="footer-bottom">
      <p class="footer-copy">© {year} Facética. Todos los derechos reservados.</p>
      <p class="footer-copy">Hecho en Chile.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-bg-secondary);
    padding-top: var(--space-80);
    padding-bottom: var(--space-48);
  }

  /* ── Top ── */
  .footer-top {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-bottom: var(--space-48);
  }

  .footer-logo {
    display: inline-flex;
    transition: opacity var(--duration-fast);
  }

  .footer-logo:hover {
    opacity: 0.6;
  }

  .footer-logo-img {
    height: 32px;
    width: auto;
    display: block;
  }

  .footer-tagline {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* ── Grid ── */
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-48);
    padding-block: var(--space-48);
  }

  .footer-col-label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-24);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .footer-link {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    transition: color var(--duration-fast);
    line-height: 1.4;
  }

  .footer-link:hover {
    color: var(--color-text-primary);
  }

  /* ── Bottom ── */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-32);
    gap: var(--space-16);
    flex-wrap: wrap;
  }

  .footer-copy {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-32);
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
