---
const items = [
  'Comunicación Corporativa',
  'Manejo de Crisis',
  'Vocería Estratégica',
  'Presencia Digital',
  'Comunicación Interna',
  'Contenido Editorial',
  'Sustentabilidad & Cultura',
];

const separator = '·';
---

<div class="marquee-section" aria-hidden="true">
  <div class="marquee-wrap">
    <div class="marquee-track">
      {/* First copy */}
      {items.map((item) => (
        <>
          <span class="marquee-item">{item}</span>
          <span class="marquee-sep">{separator}</span>
        </>
      ))}
      {/* Duplicate for seamless loop */}
      {items.map((item) => (
        <>
          <span class="marquee-item">{item}</span>
          <span class="marquee-sep">{separator}</span>
        </>
      ))}
    </div>
  </div>
</div>

<style>
  .marquee-section {
    background-color: var(--color-bg-dark-alt);
    padding-block: var(--space-32);
    overflow: hidden;
  }

  .marquee-wrap {
    overflow: hidden;
    width: 100%;
  }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: var(--space-24);
    width: max-content;
    animation: marquee-scroll 40s linear infinite;
    will-change: transform;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }

  .marquee-item {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.375rem, 2.5vw, 2rem);
    font-style: italic;
    font-weight: 300;
    color: var(--color-text-inverse);
    white-space: nowrap;
    letter-spacing: -0.01em;
    opacity: 0.85;
  }

  .marquee-sep {
    font-size: 0.75rem;
    color: var(--color-accent-champagne);
    opacity: 0.6;
    flex-shrink: 0;
  }
</style>
