---
const featured = {
  category: 'Reputación',
  date: '2026-04-01',
  title: 'Por qué el silencio corporativo dejó de ser una estrategia viable',
  href: '/ideas/silencio-corporativo',
};

const articles = [
  {
    category: 'Crisis',
    date: 'Marzo 2026',
    title: 'La diferencia entre gestionar una crisis y sobrevivir a una crisis',
    href: '/ideas/gestionar-crisis',
  },
  {
    category: 'Portavoces',
    date: 'Febrero 2026',
    title: 'Lo que revela un vocero que no sabe a qué preguntas no responder',
    href: '/ideas/vocero-preguntas',
  },
  {
    category: 'Sustentabilidad',
    date: 'Enero 2026',
    title: 'Greenwashing no es solo mentir. A veces es no decir nada en absoluto.',
    href: '/ideas/greenwashing',
  },
];
---

<section class="ideas section" aria-label="Ideas y publicaciones">
  <div class="container">
    <div class="ideas-header reveal">
      <h2 class="section-heading">Ideas</h2>
    </div>

    <!-- Featured Article -->
    <a href={featured.href} class="ideas-featured reveal">
      <div class="ideas-featured-meta">
        <span class="text-label">{featured.category}</span>
      </div>
      <h3 class="ideas-featured-title">{featured.title}</h3>
      <span class="ideas-featured-cta" aria-hidden="true">Leer →</span>
    </a>

    <!-- Article Grid -->
    <div class="ideas-grid">
      {articles.map((article, i) => (
        <a href={article.href} class={`idea-card reveal stagger-${i + 1}`}>
          <div class="idea-card-meta">
            <span class="text-label">{article.category}</span>
            <span class="idea-date text-number">{article.date}</span>
          </div>
          <h3 class="idea-title">{article.title}</h3>
          <span class="idea-link" aria-hidden="true">Leer →</span>
        </a>
      ))}
    </div>

    <!-- Footer CTA -->
    <div class="ideas-footer reveal">
      <a href="/ideas" class="arrow-link">Ver todas las ideas</a>
    </div>
  </div>
</section>

<style>
  .ideas {
    background-color: var(--color-bg-primary);
  }

  .ideas-header {
    margin-bottom: var(--space-48);
  }

  /* ── Featured ── */
  .ideas-featured {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-32);
    padding: var(--space-48);
    background-color: var(--color-bg-dark);
    margin-bottom: var(--space-4);
    border-radius: 2px;
    transition: opacity var(--duration-base);
  }

  .ideas-featured:hover {
    opacity: 0.9;
  }

  .ideas-featured-meta {
    margin-bottom: var(--space-16);
    grid-column: 1 / -1;
  }

  .ideas-featured-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-text-inverse);
    max-width: 680px;
  }

  .ideas-featured-cta {
    font-size: 0.875rem;
    color: var(--color-accent-champagne);
    white-space: nowrap;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .ideas-featured:hover .ideas-featured-cta {
    transform: translateX(4px);
  }

  /* ── Grid ── */
  .ideas-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-48);
  }

  .idea-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    padding: var(--space-32);
    background-color: var(--color-bg-secondary);
    border-radius: 2px;
    transition: background-color var(--duration-base);
  }

  .idea-card:hover {
    background-color: #ebe7e0;
  }

  .idea-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
  }

  .idea-date {
    color: var(--color-text-muted);
    font-size: 0.6875rem;
  }

  .idea-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    flex: 1;
  }

  .idea-link {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-top: auto;
    transition: color var(--duration-fast), transform var(--duration-base) var(--ease-out);
    display: inline-block;
  }

  .idea-card:hover .idea-link {
    color: var(--color-accent);
    transform: translateX(3px);
  }

  .ideas-footer {
    text-align: left;
  }

  /* ── Mobile ── */
  @media (max-width: 900px) {
    .ideas-featured {
      grid-template-columns: 1fr;
      padding: var(--space-32);
    }

    .ideas-featured-cta {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .ideas-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
