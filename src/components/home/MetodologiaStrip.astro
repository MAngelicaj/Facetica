---
const steps = [
  {
    roman: 'I',
    title: 'Diagnóstico',
    body: 'Entendemos el contexto antes de proponer nada.',
  },
  {
    roman: 'II',
    title: 'Análisis estratégico',
    body: 'Mapeamos audiencias, riesgos y oportunidades.',
  },
  {
    roman: 'III',
    title: 'Narrativa',
    body: 'Construimos el relato que le corresponde a la organización.',
  },
  {
    roman: 'IV',
    title: 'Tácticas',
    body: 'Los formatos y canales son consecuencia de la estrategia.',
  },
  {
    roman: 'V',
    title: 'Ejecución',
    body: 'Acompañamos la implementación con la misma atención con que diseñamos.',
  },
  {
    roman: 'VI',
    title: 'Resultados',
    body: 'Medimos lo que importa: confianza, percepción y reputación en el tiempo.',
  },
];
---

<section class="metodologia section" aria-label="Metodología">
  <div class="container">

    <!-- Encabezado -->
    <div class="metodologia-header reveal">
      <span class="eyebrow">Cómo trabajamos</span>
      <h2 class="section-heading">Metodología</h2>
      <p class="metodologia-sub">
        Un proceso riguroso y transparente en cada proyecto,<br />
        diseñado para construir con criterio y sin atajos.
      </p>
    </div>

    <!-- Línea de tiempo: fila de círculos -->
    <div class="timeline-circles reveal">
      {steps.map((step) => (
        <div class="timeline-node">
          <div class="timeline-circle">
            <span class="timeline-roman">{step.roman}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Textos debajo -->
    <div class="timeline-labels reveal">
      {steps.map((step) => (
        <div class="timeline-label">
          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.body}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .metodologia {
    background-color: var(--color-bg-secondary);
  }

  /* ── Encabezado ── */
  .metodologia-header {
    margin-bottom: var(--space-80);
    max-width: 560px;
  }

.metodologia-sub {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  /* ── Fila de círculos ── */
  .timeline-circles {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    position: relative;
    margin-bottom: var(--space-32);
  }

  /* Línea horizontal entre el primer y último círculo */
  .timeline-circles::before {
    content: '';
    position: absolute;
    top: 50%;
    left: calc(100% / 12);
    right: calc(100% / 12);
    height: 1px;
    background-color: var(--color-border);
    transform: translateY(-50%);
    z-index: 0;
  }

  .timeline-node {
    display: flex;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .timeline-circle {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .timeline-roman {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1rem;
    font-weight: 400;
    color: var(--color-text-secondary);
    letter-spacing: 0.02em;
  }

  /* ── Textos ── */
  .timeline-labels {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--space-16);
  }

  .timeline-label {
    text-align: center;
    padding-inline: var(--space-8);
  }

  .step-title {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--space-8);
    line-height: 1.3;
  }

  .step-desc {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* ── Tablet ── */
  @media (max-width: 900px) {
    .timeline-circles,
    .timeline-labels {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-24);
    }

    .timeline-circles::before {
      display: none;
    }

    .timeline-circles {
      margin-bottom: var(--space-16);
    }
  }

  /* ── Mobile ── */
  @media (max-width: 500px) {
    .timeline-circles,
    .timeline-labels {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
