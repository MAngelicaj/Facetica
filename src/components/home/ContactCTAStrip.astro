<section class="cta-strip" aria-label="Contacto">
  <div class="container">
    <div class="cta-inner reveal">

      <!-- Columna izquierda: texto + datos -->
      <div class="cta-left">
        <span class="eyebrow cta-eyebrow">Hablemos</span>
        <h2 class="cta-headline">
          Hay conversaciones que vale la pena tener.
        </h2>
        <p class="cta-sub">
          Si estás evaluando cómo tu organización comunica —o debería
          comunicar— podemos ser un buen punto de partida.
        </p>

        <ul class="cta-datos">
          <li class="cta-dato">
            <svg class="cta-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="2" y="4" width="16" height="12" rx="2"/>
              <path d="M2 7l8 5 8-5"/>
            </svg>
            <a href="mailto:hola@facetica.com" class="cta-dato-link">hola@facetica.com</a>
          </li>
          <li class="cta-dato">
            <svg class="cta-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M15.05 11.9c-.32-.16-1.9-.94-2.2-1.05-.29-.1-.5-.16-.71.16-.21.32-.82 1.05-.99 1.26-.18.21-.36.24-.68.08-.32-.16-1.35-.5-2.57-1.59-.95-.85-1.59-1.9-1.78-2.22-.18-.32-.02-.49.14-.65.14-.14.32-.37.48-.55.16-.18.21-.32.32-.53.1-.21.05-.4-.03-.55-.08-.16-.71-1.71-.97-2.34-.26-.61-.52-.53-.71-.54H4.9c-.18 0-.48.07-.73.34C3.92 5.8 3.1 6.57 3.1 8.1c0 1.54 1.12 3.03 1.28 3.24.16.21 2.2 3.36 5.33 4.71 3.13 1.35 3.13.9 3.69.84.56-.05 1.9-.78 2.17-1.53.26-.74.26-1.38.18-1.53-.08-.13-.29-.21-.6-.37z"/>
              <path d="M10 2a8 8 0 00-6.93 11.97L2 18l4.13-1.08A8 8 0 1010 2z"/>
            </svg>
            <a href="https://wa.me/56984795616" target="_blank" rel="noopener noreferrer" class="cta-dato-link">+56 9 8479 5616</a>
          </li>
          <li class="cta-dato">
            <svg class="cta-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M10 11a3 3 0 100-6 3 3 0 000 6z"/>
              <path d="M10 2a7 7 0 017 7c0 4-7 9-7 9S3 13 3 9a7 7 0 017-7z"/>
            </svg>
            <span class="cta-dato-text">Santiago, Chile</span>
          </li>
          <li class="cta-dato">
            <svg class="cta-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <rect x="2" y="2" width="16" height="16" rx="3"/>
              <path d="M6 9v5M6 6v.01M10 14v-4m0-3v.01M14 14v-7"/>
            </svg>
            <a href="https://www.linkedin.com/company/facetica" target="_blank" rel="noopener noreferrer" class="cta-dato-link">LinkedIn — Facética</a>
          </li>
        </ul>
      </div>

      <!-- Columna derecha: tarjeta -->
      <div class="cta-card">
        <span class="cta-card-eyebrow">Contacto directo</span>
        <p class="cta-card-tagline">Sin formularios.<br />Una conversación real.</p>
        <a href="https://wa.me/56984795616" target="_blank" rel="noopener noreferrer" class="btn-cta-coral">
          Escribir a Facética
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .cta-strip {
    background-color: var(--color-bg-primary);
    padding-block: var(--space-120);
  }

  /* ── Layout dos columnas ── */
  .cta-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-80);
    align-items: center;
  }

  /* ── Eyebrow ── */
  .cta-eyebrow {
    color: var(--color-accent);
    margin-bottom: var(--space-24);
    display: block;
  }

  /* ── Headline ── */
  .cta-headline {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-24);
  }

  /* ── Sub ── */
  .cta-sub {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-48);
  }

  /* ── Datos de contacto ── */
  .cta-datos {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .cta-dato {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  .cta-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    color: var(--color-text-muted);
  }

  .cta-dato-link {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    transition: color var(--duration-fast);
  }

  .cta-dato-link:hover {
    color: var(--color-text-primary);
  }

  .cta-dato-text {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  /* ── Tarjeta derecha ── */
  .cta-card {
    background-color: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--space-48);
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }

  .cta-card-eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .cta-card-tagline {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }

  /* ── Botón coral ── */
  .btn-cta-coral {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-accent);
    color: #fff;
    border: 1px solid var(--color-accent);
    padding: 0.75rem 1.75rem;
    font-family: 'Inter', sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    border-radius: 100px;
    cursor: pointer;
    align-self: flex-start;
    transition: background-color var(--duration-base) var(--ease-out),
                border-color var(--duration-base) var(--ease-out);
  }

  .btn-cta-coral:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .cta-inner {
      grid-template-columns: 1fr;
      gap: var(--space-48);
    }

    .cta-strip {
      padding-block: var(--space-80);
    }
  }
</style>
