---
---

<section class="hero" aria-label="Inicio">
  <div class="hero-inner container">
    <div class="hero-rule" aria-hidden="true"></div>
    <p class="hero-eyebrow text-label">Consultoría de Comunicación Estratégica</p>

    <h1 class="hero-headline">
      <span class="hero-line hero-line-1">Las palabras correctas,</span>
      <span class="hero-line hero-line-2">en el momento que importa.</span>
    </h1>

    <p class="hero-sub">
      Asesoramos a organizaciones que entienden que la comunicación
      no es un accesorio&nbsp;— es una decisión de fondo.
    </p>

    <div class="hero-actions">
      <a href="/servicios" class="btn btn-primary">Nuestros servicios</a>
      <a href="/nosotros" class="hero-text-link">
        Conocer Facética
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    background-color: var(--color-bg-primary);
    padding-top: var(--nav-height);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: var(--space-80);
  }

  /* ── Decorative rule ── */
  .hero-rule {
    width: 280px;
    height: 1px;
    background-color: var(--color-accent-champagne);
    margin-bottom: var(--space-32);
  }

  /* ── Eyebrow ── */
  .hero-eyebrow {
    margin-bottom: var(--space-32);
    animation: fade-up 500ms var(--ease-out) both;
    animation-delay: 100ms;
  }

  /* ── Headline ── */
  .hero-headline {
    display: flex;
    flex-direction: column;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.75rem, 7vw, 5rem);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--color-text-primary);
    margin-bottom: var(--space-32);
    max-width: 820px;
  }

  .hero-line {
    display: block;
  }

  .hero-line-1 {
    animation: fade-up 600ms var(--ease-out) both;
    animation-delay: 200ms;
  }

  .hero-line-2 {
    animation: fade-up 600ms var(--ease-out) both;
    animation-delay: 320ms;
  }

  /* ── Sub-copy ── */
  .hero-sub {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 500px;
    margin-bottom: var(--space-48);
    animation: fade-up 600ms var(--ease-out) both;
    animation-delay: 420ms;
  }

  /* ── Actions ── */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-32);
    flex-wrap: wrap;
    justify-content: center;
    animation: fade-up 600ms var(--ease-out) both;
    animation-delay: 520ms;
  }

  .hero-text-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2px;
    transition: color var(--duration-base) var(--ease-out),
                border-color var(--duration-base) var(--ease-out);
  }

  .hero-text-link:hover {
    color: var(--color-text-primary);
    border-color: var(--color-text-primary);
  }

  .hero-text-link span {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .hero-text-link:hover span {
    transform: translateX(4px);
  }

  /* ── Mobile ── */
  @media (max-width: 600px) {
    .hero-actions {
      flex-direction: column;
      gap: var(--space-24);
    }

    .hero-rule {
      width: 180px;
    }
  }
</style>
