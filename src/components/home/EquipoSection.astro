---
const equipo = [
  {
    nombre: 'Carla Fuentes Vicuña',
    rol: 'Socia',
    foto: '/equipo/carla-fuentes.webp',
    iniciales: 'CF',
  },
  {
    nombre: 'María Angélica Joannon Ovalle',
    rol: 'Socia',
    foto: '/equipo/maria-angelica-joannon.webp',
    iniciales: 'MJ',
  },
];
---

<section class="equipo section" aria-label="Nuestro Equipo">
  <div class="container">

    <div class="equipo-inner">

      <!-- Texto izquierda -->
      <div class="equipo-texto reveal-left">
        <span class="eyebrow">El equipo</span>
        <h2 class="section-heading equipo-titulo">Nuestro Equipo</h2>
        <p class="equipo-bajada">
          Somos profesionales con más de 15 años de experiencia en comunicación,
          desde distintos roles: medios de comunicación, mundo público, startups,
          fundaciones y agencias. Nuestra trayectoria combina criterio editorial,
          comprensión del entorno institucional y experiencia en posicionamiento estratégico.
        </p>
      </div>

      <!-- Fotos derecha -->
      <div class="equipo-grid reveal-right">
        {equipo.map((persona) => (
          <div class="equipo-card">
            <div class="equipo-foto-wrap">
              <img
                src={persona.foto}
                alt={persona.nombre}
                class="equipo-foto"
                onerror={`this.style.display='none';this.nextElementSibling.style.display='flex'`}
              />
              <div class="equipo-foto-placeholder">
                <span>{persona.iniciales}</span>
              </div>
            </div>
            <div class="equipo-info">
              <h3 class="equipo-nombre">{persona.nombre}</h3>
              <p class="equipo-rol">{persona.rol}</p>
            </div>
          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<style>
  .equipo {
    background-color: var(--color-bg-primary);
  }

  /* ── Layout principal: texto | fotos ── */
  .equipo-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-80);
    align-items: center;
  }

  /* ── Texto ── */
  .equipo-titulo {
    margin-top: var(--space-16);
    margin-bottom: var(--space-24);
  }

  .equipo-bajada {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-text-secondary);
  }

  /* ── Grid de fotos (dentro de la columna derecha) ── */
  .equipo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-32);
  }

  /* ── Card ── */
  .equipo-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  /* ── Foto ── */
  .equipo-foto-wrap {
    position: relative;
    width: 200px;
    height: 200px;
  }

  .equipo-foto {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  /* Placeholder mientras no hay foto */
  .equipo-foto-placeholder {
    display: none;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    align-items: center;
    justify-content: center;
  }

  .equipo-foto-placeholder span {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 2.5rem;
    font-weight: 300;
    color: var(--color-text-muted);
    letter-spacing: -0.02em;
  }

  /* ── Info ── */
  .equipo-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .equipo-nombre {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.375rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--color-text-primary);
  }

  .equipo-rol {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* ── Mobile ── */
  @media (max-width: 600px) {
    .equipo-grid {
      grid-template-columns: 1fr;
      gap: var(--space-48);
    }

    .equipo-foto-wrap,
    .equipo-foto,
    .equipo-foto-placeholder {
      width: 160px;
      height: 160px;
    }
  }
</style>
