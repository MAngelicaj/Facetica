---
const pillars = [
  {
    title: 'Rigor analítico',
    body: 'No trabajamos con intuiciones. Cada recomendación parte de un diagnóstico honesto del contexto y sus implicancias.',
  },
  {
    title: 'Claridad narrativa',
    body: 'Traducimos complejidad institucional en mensajes que se entienden, se recuerdan y se creen.',
  },
  {
    title: 'Precisión bajo presión',
    body: 'Las situaciones críticas exigen criterio, no velocidad. Sabemos cuándo hablar y cuándo esperar.',
  },
];
---

<section class="pillars section" aria-label="Filosofía de trabajo">
  <div class="container">
    <div class="pillars-grid">
      {pillars.map((pillar, i) => (
        <div class={`pillar reveal stagger-${i + 1}`}>
          <h3 class="pillar-title">{pillar.title}</h3>
          <p class="pillar-body">{pillar.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pillars {
    background-color: var(--color-bg-secondary);
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .pillar {
    padding: var(--space-48);
    border-right: 1px solid var(--color-border);
  }

  .pillar:last-child {
    border-right: none;
  }

  .pillar:first-child {
    padding-left: 0;
  }

  .pillar:last-child {
    padding-right: 0;
  }

  .pillar-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.375rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--color-text-primary);
    margin-bottom: var(--space-16);
  }

  .pillar-body {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  /* ── Mobile ── */
  @media (max-width: 900px) {
    .pillars-grid {
      grid-template-columns: 1fr;
    }

    .pillar {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
      padding: var(--space-32) 0;
    }

    .pillar:first-child {
      padding-top: 0;
    }

    .pillar:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }
  }
</style>
